    </div>
  );
}

function RiskBinStrip({ score }) {
  const activeQ = binOf(score);
  return (
    <div style={{ display: "flex", gap: 4 }}>
      {RISK_BINS.map((b) => {
        const active = b.q === activeQ;
        return (
          <div
            key={b.q}
            style={{
              flex: 1,
              padding: "8px 6px",
              borderRadius: 8,
              textAlign: "center",
              background: active ? C.tealDim : C.panelAlt,
              border: `1px solid ${active ? C.teal : C.borderSoft}`,
            }}
          >
            <div
              style={{
                fontSize: 10,
                color: active ? C.teal : C.textFaint,
                fontFamily: FONT_MONO,
                marginBottom: 3,
              }}
            >
              {b.q}
            </div>
            <div
              style={{
                fontSize: 13,
                fontFamily: FONT_MONO,
                fontWeight: 700,
                color: active ? C.text : C.textDim,
              }}
            >
              {b.actual}%
            </div>
          </div>
        );
      })}
    </div>
  );
}

