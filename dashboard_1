function buildSeries(seed, drawdownFrom) {
  const stock = [100];
  const kospi = [100];
  let s = 100,
    k = 100;
  for (let i = 1; i <= 20; i++) {
    const noise = Math.sin(i * seed) * 0.6;
    const drift = i < drawdownFrom ? 1.1 : -0.35;
    s += drift + noise;
    k += 0.15 + noise * 0.2;
    stock.push(Math.round(s * 10) / 10);
    kospi.push(Math.round(k * 10) / 10);
  }
  return stock.map((v, i) => ({ day: i, stock: v, kospi: kospi[i] }));
}

