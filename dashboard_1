// Risk bins (2026 stress test) — used to translate a raw score into an
// observed base rate, since the model's raw probabilities under-calibrate.
const RISK_BINS = [
  { q: "Q1", score: 0.139, actual: 7.1 },
  { q: "Q2", score: 0.312, actual: 14.5 },
  { q: "Q3", score: 0.5, actual: 34.5 },
  { q: "Q4", score: 0.7, actual: 52.7 },
  { q: "Q5", score: 0.805, actual: 64.3 },
];

function calibratedRisk(score) {
  const pts = RISK_BINS;
  if (score <= pts[0].score) return pts[0].actual;
  if (score >= pts[pts.length - 1].score) return pts[pts.length - 1].actual;
  for (let i = 0; i < pts.length - 1; i++) {
    const a = pts[i],
      b = pts[i + 1];
    if (score >= a.score && score <= b.score) {
      const t = (score - a.score) / (b.score - a.score);
      return a.actual + t * (b.actual - a.actual);
    }
  }
  return pts[pts.length - 1].actual;
}

function binOf(score) {
  const pts = RISK_BINS;
  for (let i = pts.length - 1; i >= 0; i--) {
    if (score >= pts[i].score - 0.1) return pts[i].q;
  }
  return "Q1";
}

